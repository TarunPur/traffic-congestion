# Clearline — environment variables (names only; never commit real values)
# Copy to .env.local and fill in. NEXT_PUBLIC_* are exposed to the browser — safe values only.

# Supabase (project: https://sgwazmaiaydkgdizguxy.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC. Never logged, never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=

# MapLibre style (safe in browser, no key) — OpenFreeMap liberty
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Planner (server-only). Absent → Planner runs on the locked sample-plan stub (P4.1).
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Feature flags (ERD §11) — billing OFF in the pilot; live-fulfilment source
NEXT_PUBLIC_BILLING_ENABLED=false
LIVE_FULFILMENT_SOURCE=diy
